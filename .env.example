# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (free tier: https://www.mongodb.com/cloud/atlas)
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/portfolio
MONGODB_URI=

# ── Admin panel auth ──────────────────────────────────────────────────────────
# Secret used to sign the admin session cookie.
# Generate one with:  openssl rand -base64 32   (or any long random string)
AUTH_SECRET=

# The password you type at /admin/login
ADMIN_PASSWORD=

# ── Contact form ──────────────────────────────────────────────────────────────
# Messages are always stored in the DB (admin → Messages inbox).
# Set RESEND_API_KEY to ALSO get an email notification per message.
RESEND_API_KEY=
# Where notification emails are delivered (default: nuruzaman.milon@gmail.com)
CONTACT_EMAIL=

# ── SEO (optional) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://nuruzaman-milon.vercel.app
